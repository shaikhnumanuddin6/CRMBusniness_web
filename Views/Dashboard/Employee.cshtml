@model BusinessCRM.ViewModels.EmployeeDashboardViewModel

@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-2">
    <!-- Welcome Banner -->
    <div class="card bg-primary text-white border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    <span class="badge bg-white text-primary mb-2 px-3 py-2 fw-semibold">Employee Portal</span>
                    <h2 class="fw-bold mb-1">Welcome back, @Model.FullName!</h2>
                    <p class="mb-0 text-white-50">Here is your daily work summary and attendance status.</p>
                </div>
                <div class="mt-3 mt-md-0">
                    <span class="badge bg-light text-dark fs-6 px-3 py-2">
                        Role: @Model.Role
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Attendance & Time Card -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Daily Attendance</h5>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Phase 5: Attendance Module</span>
                </div>
                <div class="card-body p-4">
                    <div class="text-center py-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light text-secondary rounded-circle mb-3" style="width: 72px; height: 72px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
                                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                            </svg>
                        </div>
                        <h4 class="fw-bold mb-1">Not Clocked In</h4>
                        <p class="text-muted small mb-4">No active clock-in recorded for today.</p>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-success px-4" disabled title="Phase 5 attendance tracking integration">
                                Clock In (Phase 5)
                            </button>
                            <button type="button" class="btn btn-outline-secondary px-4" disabled>
                                Clock Out
                            </button>
                        </div>
                        <p class="text-muted small mt-3 mb-0">Live attendance capture with server UTC timestamps will activate in Phase 5.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile & Tasks Overview -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">My Profile Details</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Username</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>

                        <dt class="col-sm-4 text-muted">Work Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted">Account Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">Active</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">System Role</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.Role</span>
                        </dd>
                    </dl>

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">Assigned Tasks</h6>
                            <span class="badge bg-secondary">0 Pending</span>
                        </div>
                        <p class="text-muted small mb-0">Task assignment and workflow tracking will be connected in Phase 7.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
